portfolio.js

# Never commit this — a local .env is only for running ingest.py by hand
# (e.g. inside a Codespace) with GEMINI_API_KEY set without exporting it
# into your shell. The real scheduled/on-demand runs use GitHub Actions'
# own secret store (see .github/workflows/refresh.yml), not this file.
.env

